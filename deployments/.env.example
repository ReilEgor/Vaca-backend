# PostgreSQL
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=main_db

# Service Databases
DATA_PROCESSOR_DB_URL=postgres://your_user:your_password@localhost:5432/main_db?sslmode=disable

USER_DB_URL=postgres://your_user:your_password@postgres:5432/main_db?sslmode=disable

# Keycloak (realm vaca_realm, see frontend/src/keycloak.js). The JWKS URL is read by user-service inside the
# compose network; the issuer must equal the "iss" claim of the tokens, i.e. the public address of Keycloak.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/vaca_realm/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8081/realms/vaca_realm

# Secret for service-to-service calls (the Telegram bot confirming a link code)
INTERNAL_TOKEN=change_me

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBIT_URL=amqp://guest:guest@localhost:5672/
NOTIFICATION_QUEUE=notification_queue

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password

# REST API
HTTP_PORT=8080

# gRPC
GRPC_PORT=50051
STATE_SERVICE_ADDRESS=localhost:50051
SEARCH_SERVICE_ADDRESS=localhost:50051